{
  "files.exclude": {
    "**/.build": true,
    "**/.swiftpm": true,
    "**/.mikrokhoros": true,
    "**/.venv": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/.build": true,
    "**/.swiftpm": true
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true
  }
}
